# =====================================================================
# ORSYNE — configuration
# Copiez en .env et renseignez. En production (NODE_ENV=production), le
# service REFUSE de demarrer si un reglage indispensable manque.
# =====================================================================

NODE_ENV=development
PORT=3000
# Adresse publique : liens des emails, retours de paiement. https en production.
ORSYNE_PUBLIC_URL=http://localhost:3000

# --- Base de donnees ---------------------------------------------------
# Compte proprietaire : migrations uniquement.
ORSYNE_ADMIN_DATABASE_URL=postgres://orsyne@127.0.0.1:5433/orsyne_dev
# Compte applicatif : NOBYPASSRLS, c'est par lui que passe tout le produit.
ORSYNE_DATABASE_URL=postgres://orsyne_app@127.0.0.1:5433/orsyne_dev
# Mot de passe du compte applicatif, applique au demarrage (docker, cloud).
# ORSYNE_APP_DB_PASSWORD=
ORSYNE_MIGRATE_ON_BOOT=true
# Restaurant de demonstration complet au premier demarrage.
ORSYNE_SEED_DEMO=false

# Derriere un reverse proxy (Railway, Render, nginx) :
ORSYNE_TRUST_PROXY=false

# --- Paiements -----------------------------------------------------------
# console = demonstration, rien n'est debite. stripe = production.
ORSYNE_PAYMENT_PROVIDER=console
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook a declarer chez Stripe : <ORSYNE_PUBLIC_URL>/api/webhooks/payments
# Evenements : checkout.session.completed, checkout.session.expired,
#   payment_intent.succeeded, payment_intent.payment_failed,
#   payment_intent.amount_capturable_updated

# --- Emails --------------------------------------------------------------
# console | resend | postmark
ORSYNE_EMAIL_PROVIDER=console
ORSYNE_EMAIL_FROM=Mon Restaurant <reservations@mondomaine.fr>
# RESEND_API_KEY=re_...
# POSTMARK_SERVER_TOKEN=...

# --- SMS / WhatsApp ------------------------------------------------------
# console | twilio
ORSYNE_SMS_PROVIDER=console
# ORSYNE_SMS_FROM=+33...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# --- Automatismes ----------------------------------------------------------
ORSYNE_JOBS_ENABLED=true
ORSYNE_REMINDER_HOURS_BEFORE=20
ORSYNE_NO_SHOW_AFTER_MINUTES=30
